<launch>
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find raicom_safe_city)/urdf/raicom_guard_rover.urdf.xacro'"/>
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" output="screen"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>
  <node name="rviz_robot" pkg="rviz" type="rviz"
        args="-d $(find raicom_safe_city)/config/robot_model.rviz" output="screen"/>
</launch>

<launch>
  <arg name="start_gazebo" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>

  <group if="$(arg start_gazebo)">
    <include file="$(find raicom_safe_city)/launch/gazebo.launch">
      <arg name="gui" value="$(arg gui)"/>
      <arg name="headless" value="$(arg headless)"/>
    </include>
  </group>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <rosparam file="$(find raicom_safe_city)/config/gmapping.yaml" command="load"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="scan_topic" value="/scan"/>
  </node>

  <node if="$(arg rviz)" name="rviz_slam" pkg="rviz" type="rviz"
        args="-d $(find raicom_safe_city)/config/slam_mapping.rviz" output="screen"/>
</launch>

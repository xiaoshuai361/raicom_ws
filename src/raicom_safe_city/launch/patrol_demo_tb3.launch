<launch>
  <arg name="rviz" default="true"/>
  <arg name="auto_start" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>

  <include file="$(find raicom_safe_city)/launch/navigation_tb3.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
  </include>

  <node name="multi_goal_patrol" pkg="raicom_safe_city" type="multi_goal_patrol.py" output="screen">
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="goal_timeout" value="80.0"/>
  </node>
</launch>
